{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musicx",
  "mainBinaryName": "musicx",
  "version": "0.4.5",
  "identifier": "com.musicx.audioplayer",
  "build": {
    "beforeDevCommand": "node scripts/fetch-runtime-sidecars.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-runtime-sidecars.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "musicx",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/neo-yt-dlp"],
    "linux": {
      "rpm": {
        "obsoletes": ["musicx-the-audio-player"],
        "provides": ["musicx-the-audio-player"]
      },
      "deb": {
        "replaces": ["musicx-the-audio-player"],
        "conflicts": ["musicx-the-audio-player"],
        "provides": ["musicx-the-audio-player"]
      }
    }
  }
}
